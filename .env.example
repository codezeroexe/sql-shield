# Copy these into your shell or prefix the command, e.g.
#   PORT=3000 HOST=127.0.0.1 npm start
# The server does not read a .env file by itself.

# Port to listen on: whole number 0-65535. Default 3000.
PORT=3000

# Address to bind: an IP address or "localhost". Default 127.0.0.1 (this machine only).
# 0.0.0.0 exposes the arbitrary-SQL endpoint to the whole network. Do not use it on a shared network.
HOST=127.0.0.1

# Database location. Default ":memory:" (reseeded with four demo users on every start).
# A file path keeps data between restarts; its folder must exist.
DB_PATH=:memory:
